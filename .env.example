# Public client configuration (never use a service_role key here)
VITE_SUPABASE_URL=https://tqnzlwkakeocxufznjfi.supabase.co
# Prefer a publishable key; legacy anon is supported for existing projects.
# Set either key. Vercel production/development use the owner-supplied anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Optional direct Gemini provider; empty uses Vercel AI Gateway OIDC
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_GATEWAY_MODEL=google/gemini-3.8-flash
PORT=3000
